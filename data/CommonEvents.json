Mau ibu transferin buat jaga-jaga? "]},{"code":401,"indent":2,"parameters":["Rp200.000 aja, biar ada cadangan."]},{"code":101,"indent":2,"parameters":["Actor1",0,0,2,"Bono"]},{"code":401,"indent":2,"parameters":["(Sebenernya... lumayan juga kalau dapet tambahan segitu)"]},{"code":101,"indent":2,"parameters":["Actor1",0,0,2,"Bono"]},{"code":401,"indent":2,"parameters":["(Tapi aku kan udah janji sama diri sendiri, bulan ini mau mandiri.)"]},{"code":101,"indent":2,"parameters":["",0,0,2,""]},{"code":401,"indent":2,"parameters":["Terima tawaran Ibu?"]},{"code":102,"indent":2,"parameters":[["Terima","Tolak"],1,0,2,0]},{"code":402,"indent":2,"parameters":[0,"Terima"]},{"code":122,"indent":3,"parameters":[1,1,1,0,200000]},{"code":121,"indent":3,"parameters":[19,19,0]},{"code":101,"indent":3,"parameters":["Actor1",0,0,2,"Bono"]},{"code":401,"indent":3,"parameters":["Boleh deh, Bu. Makasih banyak."]},{"code":101,"indent":3,"parameters":["People1",5,0,2,"Ibu"]},{"code":401,"indent":3,"parameters":["Iya nak, jangan segan-segan ya sama ibu."]},{"code":101,"indent":3,"parameters":["Actor1",0,0,2,"Bono"]},{"code":401,"indent":3,"parameters":["Aku ngerasa dikit... gagal. Tapi ya udahlah, lumayan juga."]},{"code":0,"indent":3,"parameters":[]},{"code":402,"indent":2,"parameters":[1,"Tolak"]},{"code":101,"indent":3,"parameters":["Actor1",0,0,2,"Bono"]},{"code":401,"indent":3,"parameters":["Gak usah, Bu. Aku masih bisa kok sejauh ini."]},{"code":101,"indent":3,"parameters":["People1",5,0,2,"Ibu"]},{"code":401,"indent":3,"parameters":["Yakin? Ya udah, tapi inget, kapan pun boleh minta ya"]},{"code":101,"indent":3,"parameters":["Actor1",0,0,2,"Bono"]},{"code":401,"indent":3,"parameters":["Lega rasanya. Setidaknya sampai sekarang, aku masih pegang janjiku sendiri."]},{"code":0,"indent":3,"parameters":[]},{"code":404,"indent":2,"parameters":[]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parame